# Copy to .env and fill in. NEVER commit your real .env.

# --- Alpaca (data + paper trading) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
# iex (free, partial volume) or sip (paid, full tape — better VWAP)
ALPACA_DATA_FEED=iex

# --- Trading universe ---
PRIMARY_SYMBOL=SPY
TRADE_OPTIONS=true
MAX_DTE=1

# --- Loop ---
POLL_SECONDS=30

# --- Risk ---
MAX_DAILY_LOSS_PCT=0.25
MAX_RISK_PER_TRADE_PCT=0.10
MAX_POSITION_PCT=0.50
MAX_TRADES_PER_DAY=0

# --- Robinhood (live, wire up tomorrow) ---
# ROBINHOOD_USERNAME=
# ROBINHOOD_PASSWORD=
# ROBINHOOD_MFA=
